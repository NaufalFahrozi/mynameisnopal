---
// The film leader countdown. 3, 2, 1, gone. Skippable, silent, and it can never get stuck:
// the overlay hides itself with a CSS animation even if every script on earth fails.
---

<div class="countdown" id="countdown" aria-hidden="true">
  <div class="leader">
    <span class="crosshair"></span>
    <span class="cd cd-1">3</span>
    <span class="cd cd-2">2</span>
    <span class="cd cd-3">1</span>
  </div>
  <p class="cd-skip">klik buat skip</p>
</div>

<script>
  const boot = () => {
    const cd = document.getElementById('countdown');
    if (!cd || cd.dataset.booted) return;
    cd.dataset.booted = '1';

    let seen = false;
    try {
      seen = sessionStorage.getItem('mnin-intro') === '1';
    } catch {
      seen = false;
    }
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduce || seen) {
      cd.remove();
      return;
    }

    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      try {
        sessionStorage.setItem('mnin-intro', '1');
      } catch {
        // storage is a luxury; the show goes on
      }
      cd.classList.add('done');
      window.setTimeout(() => cd.remove(), 600);
    };

    cd.addEventListener('click', finish);
    window.addEventListener('keydown', finish, { once: true });
    window.setTimeout(finish, 2900);
  };

  document.addEventListener('astro:page-load', boot);
  boot();
</script>

<style>
  .countdown {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: #070605;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: opacity 0.4s ease;
    /* No-JS safety net: it always fades itself out. */
    animation: cd-auto-hide 0.5s ease 2.35s both;
  }

  .countdown.done {
    opacity: 0;
    visibility: hidden;
  }

  @keyframes cd-auto-hide {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  .leader {
    position: relative;
    width: min(62vw, 34rem);
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
  }

  .crosshair {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(244, 241, 232, 0.22);
    border-radius: 50%;
  }

  .crosshair::before,
  .crosshair::after {
    content: '';
    position: absolute;
    background: rgba(244, 241, 232, 0.22);
  }

  .crosshair::before {
    left: 50%;
    top: -12%;
    width: 1px;
    height: 124%;
  }

  .crosshair::after {
    top: 50%;
    left: -12%;
    height: 1px;
    width: 124%;
  }

  .cd {
    grid-area: 1 / 1;
    font-family: var(--serif);
    font-size: clamp(7rem, 22vw, 15rem);
    line-height: 1;
    color: #f2efe6;
    opacity: 0;
    animation: cd-flash 0.6s ease both;
  }

  .cd-1 {
    animation-delay: 0s;
  }
  .cd-2 {
    animation-delay: 0.6s;
  }
  .cd-3 {
    animation-delay: 1.2s;
  }

  @keyframes cd-flash {
    0% {
      opacity: 0;
      transform: scale(1.12);
      filter: blur(6px);
    }
    30% {
      opacity: 1;
      transform: scale(1);
      filter: blur(0);
    }
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  .cd-skip {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    margin: 0;
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(244, 241, 232, 0.35);
  }
</style>
