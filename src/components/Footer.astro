---
import { site } from '../data/site';
---

<footer class="site-footer wrap">
  <div class="colophon">
    <p>
      Set in Instrument Serif &amp; Geist. Handmade CSS, zero gradients that pretend to be art.
      Film ledger synced from Letterboxd; books kept by hand.
    </p>
    <p>© {site.year} {site.name} · {site.place}. <a href="/appendix">Appendix</a>.</p>
  </div>

  <nav class="socials" aria-label="Elsewhere">
    {site.socials.map((s) => <a href={s.href} rel="me">{s.label}</a>)}
    <a href={`mailto:${site.email}`}>Email</a>
  </nav>
</footer>
