---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <BaseHead title={title} description={description} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">lewati ke konten</a>
    <canvas id="grain" aria-hidden="true" transition:persist></canvas>
    <div id="lens" aria-hidden="true" transition:persist></div>
    <Header />
    <main id="main" class="wrap">
      <slot />
    </main>
    <Footer />

    <script>
      const html = document.documentElement;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Film grain: low-res noise, upscaled, cheap. Set up once.
      const canvas = document.getElementById('grain') as HTMLCanvasElement | null;
      if (canvas && !html.dataset.grain) {
        html.dataset.grain = '1';
        const ctx = canvas.getContext('2d');
        const draw = () => {
          if (!ctx) return;
          const w = canvas.width;
          const h = canvas.height;
          const img = ctx.createImageData(w, h);
          const data = img.data;
          for (let i = 0; i < data.length; i += 4) {
            const v = (Math.random() * 255) | 0;
            data[i] = v;
            data[i + 1] = v;
            data[i + 2] = v;
            data[i + 3] = 255;
          }
          ctx.putImageData(img, 0, 0);
        };
        const resize = () => {
          canvas.width = Math.max(1, Math.ceil(window.innerWidth / 3));
          canvas.height = Math.max(1, Math.ceil(window.innerHeight / 3));
          draw();
        };
        resize();
        window.addEventListener('resize', resize);
        if (!reduceMotion) window.setInterval(draw, 90);
      }

      // Lens cursor. Desktop only, set up once.
      const lens = document.getElementById('lens');
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (lens && finePointer && !reduceMotion && !html.dataset.lens) {
        html.dataset.lens = '1';
        html.classList.add('has-lens');
        let x = -100;
        let y = -100;
        let tx = -100;
        let ty = -100;
        const loop = () => {
          x += (tx - x) * 0.22;
          y += (ty - y) * 0.22;
          lens.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
          window.requestAnimationFrame(loop);
        };
        window.addEventListener(
          'pointermove',
          (event) => {
            tx = event.clientX;
            ty = event.clientY;
          },
          { passive: true },
        );
        window.addEventListener(
          'pointerover',
          (event) => {
            const target = event.target;
            if (target instanceof Element && target.closest('a, button')) lens.classList.add('grow');
          },
          true,
        );
        window.addEventListener(
          'pointerout',
          (event) => {
            const target = event.target;
            if (target instanceof Element && target.closest('a, button')) lens.classList.remove('grow');
          },
          true,
        );
        window.requestAnimationFrame(loop);
      }

      // Scroll reveals: re-init on every page load, because client-side
      // navigation replaces the DOM and old observers are useless.
      const initReveals = () => {
        const els = document.querySelectorAll('[data-reveal]:not(.in)');
        if (!els.length) return;
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.05, rootMargin: '0px 0px -6% 0px' },
        );
        els.forEach((el) => io.observe(el));
      };
      document.addEventListener('astro:page-load', initReveals);
      initReveals();
    </script>
  </body>
</html>
