---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../data/site';

const elsewhere = [
  { label: 'GitHub', href: 'https://github.com/NaufalFahrozi', note: 'tempat kode' },
  { label: 'Letterboxd', href: 'https://letterboxd.com/NaufalFahrozi', note: 'tempat film' },
  { label: 'Hardcover', href: 'https://hardcover.app/@NaufalFahrozi', note: 'tempat buku' },
  { label: 'Instagram', href: 'https://www.instagram.com/naufalfahrozi', note: 'tempat foto yang jarang diunggah' },
  { label: 'X', href: 'https://x.com/NaufalFahrozi', note: 'tempat pendapat' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/naufalfahrozi', note: 'versi formal dari diriku' },
];
---

<Base title="Contact" description="Email and elsewhere: the fastest way to reach Naufal Fahrozi.">
  <PageHead kicker="Reel 07 · Contact" title="Contact">
    <p>Email paling gampang. Cepet dibales kalau pertanyaannya bagus.</p>
  </PageHead>

  <section class="mail-section">
    <p class="label">Email</p>
    <button class="big-mail" id="mailCopy" type="button" data-mail={site.email}>
      {site.email}
    </button>
    <p class="mail-hint" id="mailHint">
      klik buat salin · atau <a href={`mailto:${site.email}`}>kirim langsung</a>
    </p>
  </section>

  <section class="elsewhere" aria-labelledby="elsewhere-heading" data-reveal>
    <h2 id="elsewhere-heading" class="label">Elsewhere</h2>
    <dl class="social-list">
      {
        elsewhere.map((item) => (
          <div class="social-row">
            <dt>{item.label}</dt>
            <dd>
              <a href={item.href}>{item.href.replace('https://', '').replace('www.', '')}</a>
              <span class="social-note"> · {item.note}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</Base>

<script>
  const setupMail = () => {
    const button = document.getElementById('mailCopy');
    const hint = document.getElementById('mailHint');
    if (!button || button.dataset.wired) return;
    button.dataset.wired = '1';
    button.addEventListener('click', async () => {
      const mail = button.getAttribute('data-mail') ?? '';
      try {
        await navigator.clipboard.writeText(mail);
        if (hint) hint.innerHTML = 'disalin. sekarang tinggal kirim.';
      } catch {
        if (hint) hint.innerHTML = 'gagal nyalin. ya udah, ketik manual aja.';
      }
    });
  };
  document.addEventListener('astro:page-load', setupMail);
  setupMail();
</script>

<style>
  .mail-section {
    margin-top: 2.75rem;
  }

  .big-mail {
    display: block;
    margin: 0.9rem 0 0;
    padding: 0;
    background: none;
    border: 0;
    font-family: var(--serif);
    font-size: var(--text-2xl);
    line-height: 1.1;
    color: var(--rubric);
    text-align: left;
    word-break: break-word;
    transition: color 0.15s ease;
  }

  .big-mail:hover {
    color: var(--rubric-deep);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .mail-hint {
    margin-top: 0.7rem;
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .elsewhere {
    margin-top: 3.25rem;
  }

  .social-list {
    margin: 1rem 0 0;
    border-top: 1px solid var(--rule-faint);
  }

  .social-row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 0.2rem 1.3rem;
    padding: 0.62rem 0.15rem;
    border-bottom: 1px solid var(--rule-faint);
  }

  .social-row dt {
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding-top: 0.3rem;
  }

  .social-row dd {
    margin: 0;
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }

  .social-note {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  @media (max-width: 34rem) {
    .social-row {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
