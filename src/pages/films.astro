---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { recentFilms } from '../lib/letterboxd';
import { archive } from '../data/letterboxd-archive';
import { topTen, filmsEpigraph } from '../data/films';

const { films, fetchedAt, live } = await recentFilms(8);

const firstYear = archive.filmsPerYear[0]?.year ?? '';
const lastYear = archive.filmsPerYear[archive.filmsPerYear.length - 1]?.year ?? '';
const statsLine = `${archive.totals.watched} films · ${archive.totals.rated} ratings · avg ${archive.averageRating.toFixed(1)}★ · ${firstYear} sampai ${lastYear}`;

const maxRatingCount = Math.max(...archive.ratingDistribution.map((b) => b.count), 1);
const maxYearCount = Math.max(...archive.filmsPerYear.map((b) => b.count), 1);

const fmtDate = (iso: string | null | undefined) =>
  iso
    ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).format(
        new Date(iso),
      )
    : '';

const syncedLabel = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  hour: '2-digit',
  minute: '2-digit',
}).format(new Date(fetchedAt));

/** Teks review impor: makna tetap, dash panjang dibuang. Aturan rumah. */
const tameDashes = (text: string) => text.replace(/[—–]/g, '-');

const excerpt = (text: string, max = 200) => {
  const tamed = tameDashes(text);
  return tamed.length > max ? tamed.slice(0, max).replace(/\s+\S*$/, '') + '…' : tamed;
};

const THIRTY_DAYS = 30 * 864e5;

const isBackfilled = (film: { watchedDate: string | null; loggedAt: string | null }) =>
  Boolean(film.watchedDate) &&
  Boolean(film.loggedAt) &&
  Math.abs(new Date(film.loggedAt as string).valueOf() - new Date(film.watchedDate as string).valueOf()) >
    THIRTY_DAYS;

const reelTitles = topTen.map((film) => film.title);
---

<Base
  title="Films"
  description="Ledger film, sinkron otomatis dari Letterboxd. Rewatch dihitung."
>
  <PageHead kicker="Reel 02 · Films" title="Films">
    <p>Sinkron otomatis dari Letterboxd. Rewatch dihitung, ga ada yang disembunyiin.</p>
  </PageHead>

  <p class="stats">{statsLine}</p>

  <div class="charts" data-reveal>
    <div class="chart">
      <p class="label">Rating distribution · {archive.totals.rated} rating asli</p>
      <div class="chart-bars" role="img" aria-label="Distribusi rating dari diary Letterboxd">
        {
          archive.ratingDistribution.map((bucket) => (
            <div class="bar" title={`${bucket.count} film · ${bucket.rating}★`}>
              <span class="bar-count">{bucket.count}</span>
              <div class="bar-track">
                <span
                  class="bar-fill"
                  style={`height: ${Math.round((bucket.count / maxRatingCount) * 100)}%`}
                />
              </div>
              <span class="bar-label">{bucket.rating}</span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="chart">
      <p class="label">Films logged per year</p>
      <div class="chart-bars" role="img" aria-label="Jumlah film per tahun">
        {
          archive.filmsPerYear.map((bucket) => (
            <div class="bar" title={`${bucket.count} film · ${bucket.year}`}>
              <span class="bar-count">{bucket.count}</span>
              <div class="bar-track">
                <span
                  class="bar-fill"
                  style={`height: ${Math.round((bucket.count / maxYearCount) * 100)}%`}
                />
              </div>
              <span class="bar-label">{bucket.year}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <blockquote class="epigraph" data-reveal>
    <p><em>“{filmsEpigraph.text}”</em></p>
    <p class="epigraph-source">· {filmsEpigraph.source}</p>
  </blockquote>

  <section class="ledger-section" aria-labelledby="recent-heading" data-reveal>
    <div class="section-head">
      <h2 id="recent-heading" class="label">Recently logged</h2>
      <p class="cur-meta">
        synced {syncedLabel} {live ? '' : '· from committed cache'}
      </p>
    </div>

    <ol class="film-ledger">
      {
        films.map((film) => (
          <li class="film-row">
            <span class="film-date">{fmtDate(film.watchedDate)}</span>
            <div class="film-info">
              <p class="film-title-line">
                <a class="film-title" href={film.link}>
                  {film.title}
                </a>
                <span class="film-year">({film.year})</span>
                {film.stars && <span class="film-stars">{film.stars}</span>}
                {film.rewatch && <span class="film-badge">rewatch</span>}
                {film.liked && <span class="film-badge">liked</span>}
                {isBackfilled(film) && film.loggedAt && (
                  <span class="film-badge film-badge-logged">logged {fmtDate(film.loggedAt)}</span>
                )}
              </p>
              {film.isReview && film.review && (
                <p class="film-note">
                  {excerpt(film.review)}
                  <a class="film-note-link" href={film.link}>
                    on Letterboxd →
                  </a>
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <p class="ledger-footnote">
      Diary lengkapnya di <a href="https://letterboxd.com/NaufalFahrozi">Letterboxd</a>. Entri lama
      yang baru dicatat dikasih penanda <em>logged</em>; ledger yang jujur ga ngehapus masa lalu.
    </p>
  </section>

  <section class="ledger-section" aria-labelledby="topten-heading" data-reveal>
    <div class="section-head">
      <h2 id="topten-heading" class="label">The top ten, not up for debate</h2>
      <p class="cur-meta">directors verified twice, because once is how mistakes happen</p>
    </div>

    <ol class="top-ten">
      {
        topTen.map((film, index) => (
          <li>
            <span class="num">{String(index + 1).padStart(2, '0')}</span>
            <span class="tt-title">{film.title}</span>
            <span class="leaders" aria-hidden="true" />
            <span class="tt-meta">
              {film.director} · {film.year}
            </span>
          </li>
        ))
      }
    </ol>

    <div class="reel">
      <button class="reel-btn" id="reelBtn" type="button" data-titles={JSON.stringify(reelTitles)}>
        bingung mau nonton apa? putar reel
      </button>
      <p class="reel-out" id="reelOut" aria-live="polite">…</p>
    </div>
  </section>
</Base>

<script>
  const setupReel = () => {
    const button = document.getElementById('reelBtn');
    const out = document.getElementById('reelOut');
    if (!button || button.dataset.wired) return;
    button.dataset.wired = '1';

    let titles: string[] = [];
    try {
      titles = JSON.parse(button.getAttribute('data-titles') ?? '[]');
    } catch {
      titles = [];
    }
    if (!titles.length) return;

    let spinning = false;
    button.addEventListener('click', () => {
      if (spinning) return;
      spinning = true;
      let ticks = 0;
      const spin = () => {
        if (out) out.textContent = titles[Math.floor(Math.random() * titles.length)];
        ticks += 1;
        if (ticks < 12) {
          window.setTimeout(spin, 50 + ticks * 14);
        } else {
          spinning = false;
        }
      };
      spin();
    });
  };
  document.addEventListener('astro:page-load', setupReel);
  setupReel();
</script>

<style>
  .stats {
    margin-top: 2.25rem;
    font-family: var(--mono);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    color: var(--rubric);
  }

  .charts {
    margin-top: 2.25rem;
    display: grid;
    gap: 3rem;
  }

  .chart-bars {
    display: flex;
    align-items: stretch;
    gap: clamp(0.35rem, 1vw, 0.7rem);
    height: 10rem;
    margin-top: 1.1rem;
  }

  .bar {
    flex: 1;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.4rem;
    min-width: 0;
  }

  .bar-count {
    font-family: var(--mono);
    font-size: 0.66rem;
    color: var(--ink-faint);
    text-align: center;
    opacity: 0.6;
    transition: opacity 0.15s ease;
  }

  .bar:hover .bar-count {
    opacity: 1;
    color: var(--rubric);
  }

  .bar-track {
    display: flex;
    align-items: flex-end;
  }

  .bar-fill {
    width: 100%;
    min-height: 2px;
    background: var(--rubric);
    border-radius: 2px 2px 0 0;
    opacity: 0.8;
    transition: opacity 0.15s ease;
  }

  .bar:hover .bar-fill {
    opacity: 1;
  }

  .bar-label {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    text-align: center;
  }

  .epigraph {
    margin: 2.75rem 0 0;
    padding-top: 1.4rem;
    border-top: 1px solid var(--rule);
    max-width: var(--measure);
  }

  .epigraph p {
    font-family: var(--serif);
    font-size: var(--text-lg);
    line-height: 1.42;
    color: var(--ink-soft);
    margin-bottom: 0.5rem;
  }

  .epigraph .epigraph-source {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    margin-bottom: 0;
  }

  .ledger-section {
    margin-top: 3.5rem;
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.6rem;
    margin-bottom: 0.25rem;
  }

  .section-head .cur-meta {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    margin: 0;
  }

  .film-ledger {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .film-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.15rem 1.4rem;
    padding: 0.85rem 0.15rem;
    border-bottom: 1px solid var(--rule-faint);
    transition: background-color 0.15s ease;
  }

  .film-row:hover {
    background-color: rgba(244, 241, 232, 0.03);
  }

  .film-date {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    padding-top: 0.42rem;
    white-space: nowrap;
  }

  .film-badge-logged {
    color: var(--ink-faint);
    border-color: var(--rule);
  }

  .film-info {
    min-width: 0;
  }

  .film-title-line {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.7rem;
  }

  .film-title {
    font-family: var(--serif);
    font-size: var(--text-xl);
    line-height: 1.1;
    color: var(--ink);
    text-decoration: none;
  }

  .film-title:hover {
    color: var(--rubric);
  }

  .film-year {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .film-stars {
    font-size: var(--text-sm);
    color: var(--rubric);
    letter-spacing: 0.08em;
  }

  .film-badge {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rubric);
    border: 1px solid rgba(224, 123, 84, 0.45);
    padding: 0.06rem 0.42rem;
    border-radius: 2px;
  }

  .film-note {
    margin: 0.45rem 0 0;
    max-width: var(--measure);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .film-note-link {
    display: block;
    margin-top: 0.35rem;
    font-family: var(--mono);
    font-size: var(--text-xs);
  }

  .ledger-footnote {
    margin-top: 1.1rem;
    font-family: var(--mono);
    font-size: var(--text-xs);
    line-height: 1.9;
    color: var(--ink-faint);
    max-width: 46rem;
  }

  .top-ten {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-faint);
  }

  .top-ten li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 1rem;
    padding: 0.72rem 0.15rem;
    border-bottom: 1px solid var(--rule-faint);
  }

  .top-ten .num {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--rubric);
    width: 2rem;
    flex: none;
  }

  .top-ten .tt-title {
    font-family: var(--serif);
    font-size: var(--text-xl);
    line-height: 1.05;
  }

  .top-ten .leaders {
    flex: 1 1 2rem;
    border-bottom: 1px dotted var(--rule);
    transform: translateY(-0.32em);
    min-width: 1.5rem;
  }

  .top-ten .tt-meta {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    text-align: right;
  }

  .reel {
    margin-top: 1.6rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 1.2rem;
  }

  .reel-btn {
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rubric);
    background: none;
    border: 1px solid rgba(224, 123, 84, 0.5);
    border-radius: 2px;
    padding: 0.5rem 1rem;
    transition: background-color 0.15s ease;
  }

  .reel-btn:hover {
    background: var(--rubric-wash);
  }

  .reel-out {
    margin: 0;
    font-family: var(--serif);
    font-size: var(--text-xl);
    color: var(--ink);
    min-height: 1.3em;
  }

  @media (max-width: 40rem) {
    .film-row {
      grid-template-columns: 1fr;
    }

    .film-date {
      padding-top: 0;
      margin-bottom: 0.3rem;
    }

    .top-ten .tt-meta {
      width: 100%;
      text-align: left;
      padding-left: 3rem;
    }

    .bar-label {
      font-size: 0.6rem;
    }
  }
</style>
