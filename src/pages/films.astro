---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { recentFilms } from '../lib/letterboxd';
import { topTen, filmsEpigraph } from '../data/films';

const { films, fetchedAt, live } = await recentFilms(8);

const fmtDate = (iso: string | null | undefined) =>
  iso
    ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).format(
        new Date(iso),
      )
    : '';

const syncedLabel = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  hour: '2-digit',
  minute: '2-digit',
}).format(new Date(fetchedAt));

const excerpt = (text: string, max = 220) =>
  text.length > max ? text.slice(0, max).replace(/\s+\S*$/, '') + '…' : text;

const THIRTY_DAYS = 30 * 864e5;

/** True when the film was watched long before it was logged — a backfilled diary entry. */
const isBackfilled = (film: { watchedDate: string | null; loggedAt: string | null }) =>
  Boolean(film.watchedDate) &&
  Boolean(film.loggedAt) &&
  Math.abs(new Date(film.loggedAt as string).valueOf() - new Date(film.watchedDate as string).valueOf()) >
    THIRTY_DAYS;
---

<Base
  title="Films"
  description="A ledger of what I watch — synced from Letterboxd, plus ten films that are not up for debate."
>
  <PageHead kicker="II · Films" title="Films">
    <p>
      Semua yang kutonton dan kucatat, tersinkron dari Letterboxd — plus sepuluh film yang tidak
      bisa diganggu gugat. Tidak ada poster di sini. Poster tidak punya pendapat.
    </p>
  </PageHead>

  <blockquote class="epigraph">
    <p><em>“{filmsEpigraph.text}”</em></p>
    <p class="epigraph-source">— {filmsEpigraph.source}</p>
  </blockquote>

  <section class="ledger-section" aria-labelledby="recent-heading">
    <div class="section-head">
      <h2 id="recent-heading" class="label">Recently logged</h2>
      <p class="cur-meta">
        synced {syncedLabel} {live ? '' : '· from committed cache'}
      </p>
    </div>

    <ol class="film-ledger">
      {
        films.map((film) => (
          <li class="film-row">
            <span class="film-date">
              <span>{fmtDate(film.watchedDate)}</span>
              {isBackfilled(film) && film.loggedAt && (
                <span class="film-logged">logged {fmtDate(film.loggedAt)}</span>
              )}
            </span>
            <div class="film-body">
              <p class="film-title-line">
                <a class="film-title" href={film.link}>
                  {film.title}
                </a>
                <span class="film-year">({film.year})</span>
                {film.stars && <span class="film-stars">{film.stars}</span>}
                {film.rewatch && <span class="film-badge">rewatch</span>}
                {film.liked && <span class="film-badge">liked</span>}
              </p>
              {film.isReview && film.review && (
                <p class="film-note">
                  {excerpt(film.review)}
                  <a class="film-note-link" href={film.link}>
                    on Letterboxd →
                  </a>
                </p>
              )}
            </div>
            {film.posterSmall && (
              <span class="peek" aria-hidden="true">
                <img src={film.posterSmall} alt="" loading="lazy" decoding="async" width="230" height="345" />
              </span>
            )}
          </li>
        ))
      }
    </ol>

    <p class="ledger-footnote">
      Diary lengkapnya ada di <a href="https://letterboxd.com/NaufalFahrozi">Letterboxd</a>. Ledger
      ini menyinkron ulang setiap hari — rewatch dihitung, dan ya, angka itu tidak bohong. Entri
      lama yang baru dicatat diberi penanda <em>logged</em>; diary yang jujur tidak menghapus
      masa lalu.
    </p>
  </section>

  <section class="ledger-section" aria-labelledby="topten-heading">
    <div class="section-head">
      <h2 id="topten-heading" class="label">The top ten — not up for debate</h2>
      <p class="cur-meta">directors verified twice, because once is how mistakes happen</p>
    </div>

    <ol class="top-ten">
      {
        topTen.map((film, index) => (
          <li>
            <span class="num">{String(index + 1).padStart(2, '0')}</span>
            <span class="tt-title">{film.title}</span>
            <span class="leaders" aria-hidden="true" />
            <span class="tt-meta">
              {film.director} · {film.year}
            </span>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .epigraph {
    margin: 2.5rem 0 0;
    padding-top: 1.4rem;
    border-top: 1px solid var(--rule);
    max-width: var(--measure);
  }

  .epigraph p {
    font-family: var(--serif);
    font-size: var(--text-lg);
    line-height: 1.42;
    color: var(--ink-soft);
    margin-bottom: 0.5rem;
  }

  .epigraph .epigraph-source {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    margin-bottom: 0;
  }

  .ledger-section {
    margin-top: 3.5rem;
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.6rem;
    margin-bottom: 0.25rem;
  }

  .section-head .cur-meta {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    margin: 0;
  }

  .film-ledger {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .film-row {
    position: relative;
    display: grid;
    grid-template-columns: 6.2rem 1fr;
    gap: 0.15rem 1.3rem;
    padding: 0.85rem 0.15rem;
    border-bottom: 1px solid var(--rule-faint);
  }

  .film-date {
    display: grid;
    gap: 0.12rem;
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    padding-top: 0.42rem;
    white-space: nowrap;
  }

  .film-logged {
    color: var(--rubric);
    opacity: 0.85;
  }

  .film-title-line {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.7rem;
  }

  .film-title {
    font-family: var(--serif);
    font-size: var(--text-xl);
    line-height: 1.1;
    color: var(--ink);
    text-decoration: none;
  }

  .film-title:hover {
    color: var(--rubric);
  }

  .film-year {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .film-stars {
    font-size: var(--text-sm);
    color: var(--rubric);
    letter-spacing: 0.08em;
  }

  .film-badge {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rubric);
    border: 1px solid rgba(184, 69, 42, 0.4);
    padding: 0.06rem 0.42rem;
    border-radius: 2px;
  }

  .film-note {
    margin: 0.45rem 0 0;
    max-width: var(--measure);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .film-note-link {
    display: block;
    margin-top: 0.35rem;
    font-family: var(--mono);
    font-size: var(--text-xs);
  }

  .peek {
    display: none;
  }

  @media (min-width: 62rem) and (hover: hover) {
    .peek {
      display: block;
      position: absolute;
      right: 0;
      top: 0.6rem;
      width: 9rem;
      opacity: 0;
      transform: translateY(6px);
      transition:
        opacity 0.18s ease,
        transform 0.18s ease;
      pointer-events: none;
      z-index: 5;
      box-shadow: 0 10px 28px rgba(26, 23, 20, 0.18);
    }

    .film-row:hover .peek {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ledger-footnote {
    margin-top: 1.1rem;
    font-family: var(--mono);
    font-size: var(--text-xs);
    line-height: 1.9;
    color: var(--ink-faint);
    max-width: 46rem;
  }

  .top-ten {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-faint);
  }

  .top-ten li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 1rem;
    padding: 0.72rem 0.15rem;
    border-bottom: 1px solid var(--rule-faint);
  }

  .top-ten .num {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    width: 2rem;
    flex: none;
  }

  .top-ten .tt-title {
    font-family: var(--serif);
    font-size: var(--text-xl);
    line-height: 1.05;
  }

  .top-ten .leaders {
    flex: 1 1 2rem;
    border-bottom: 1px dotted var(--rule);
    transform: translateY(-0.32em);
    min-width: 1.5rem;
  }

  .top-ten .tt-meta {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    text-align: right;
  }

  @media (max-width: 40rem) {
    .top-ten .tt-meta {
      width: 100%;
      text-align: left;
      padding-left: 3rem;
    }
  }
</style>
