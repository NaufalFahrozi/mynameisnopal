---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { getFeed, recentFilms } from '../lib/letterboxd';
import { topTen, filmsEpigraph } from '../data/films';

const { films, fetchedAt, live } = await recentFilms(8);
const feed = await getFeed();

const logs = feed.logs;
const uniqueCount = new Set(logs.map((log) => log.slug)).size;
const rated = logs.filter((log) => typeof log.rating === 'number');
const avg = rated.length ? rated.reduce((sum, log) => sum + (log.rating as number), 0) / rated.length : null;
const statsLine = `${logs.length} logs · ${uniqueCount} films · avg ${avg ? avg.toFixed(1) : 'n/a'}★`;

const buckets = [0.5, 1, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5];
const counts = buckets.map((bucket) => logs.filter((log) => log.rating === bucket).length);
const maxCount = Math.max(...counts, 1);

const fmtDate = (iso: string | null | undefined) =>
  iso
    ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).format(
        new Date(iso),
      )
    : '';

const syncedLabel = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  hour: '2-digit',
  minute: '2-digit',
}).format(new Date(fetchedAt));

/** Teks review impor: makna tetap, dash panjang dibuang. Aturan rumah. */
const tameDashes = (text: string) => text.replace(/[—–]/g, '-');

const excerpt = (text: string, max = 200) => {
  const tamed = tameDashes(text);
  return tamed.length > max ? tamed.slice(0, max).replace(/\s+\S*$/, '') + '…' : tamed;
};

const THIRTY_DAYS = 30 * 864e5;

const isBackfilled = (film: { watchedDate: string | null; loggedAt: string | null }) =>
  Boolean(film.watchedDate) &&
  Boolean(film.loggedAt) &&
  Math.abs(new Date(film.loggedAt as string).valueOf() - new Date(film.watchedDate as string).valueOf()) >
    THIRTY_DAYS;
---

<Base
  title="Films"
  description="Ledger film, sinkron otomatis dari Letterboxd. Rewatch dihitung."
>
  <PageHead kicker="Reel 02 · Films" title="Films">
    <p>Sinkron otomatis dari Letterboxd. Rewatch dihitung, ga ada yang disembunyiin.</p>
  </PageHead>

  <p class="stats">{statsLine}</p>

  <div class="chart" data-reveal>
    <p class="label">Rating distribution, dari diary sendiri</p>
    <div class="chart-bars" role="img" aria-label="Distribusi rating dari diary Letterboxd">
      {
        buckets.map((bucket, index) => (
          <div class="bar" title={`${counts[index]} film · ${bucket}★`}>
            <div class="bar-track">
              <span
                class="bar-fill"
                style={`height: ${Math.round((counts[index] / maxCount) * 100)}%`}
              />
            </div>
            <span class="bar-label">{bucket}</span>
          </div>
        ))
      }
    </div>
  </div>

  <blockquote class="epigraph" data-reveal>
    <p><em>“{filmsEpigraph.text}”</em></p>
    <p class="epigraph-source">· {filmsEpigraph.source}</p>
  </blockquote>

  <section class="ledger-section" aria-labelledby="recent-heading" data-reveal>
    <div class="section-head">
      <h2 id="recent-heading" class="label">Recently logged</h2>
      <p class="cur-meta">
        synced {syncedLabel} {live ? '' : '· from committed cache'}
      </p>
    </div>

    <ol class="film-ledger">
      {
        films.map((film) => (
          <li class="film-row">
            <span class="film-date">
              <span>{fmtDate(film.watchedDate)}</span>
              {isBackfilled(film) && film.loggedAt && (
                <span class="film-logged">logged {fmtDate(film.loggedAt)}</span>
              )}
            </span>
            <div class="film-info">
              <p class="film-title-line">
                <a class="film-title" href={film.link}>
                  {film.title}
                </a>
                <span class="film-year">({film.year})</span>
                {film.stars && <span class="film-stars">{film.stars}</span>}
                {film.rewatch && <span class="film-badge">rewatch</span>}
                {film.liked && <span class="film-badge">liked</span>}
              </p>
              {film.isReview && film.review && (
                <p class="film-note">
                  {excerpt(film.review)}
                  <a class="film-note-link" href={film.link}>
                    on Letterboxd →
                  </a>
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <p class="ledger-footnote">
      Diary lengkapnya di <a href="https://letterboxd.com/NaufalFahrozi">Letterboxd</a>. Entri lama
      yang baru dicatat dikasih penanda <em>logged</em>; ledger yang jujur ga ngehapus masa lalu.
    </p>
  </section>

  <section class="ledger-section" aria-labelledby="topten-heading" data-reveal>
    <div class="section-head">
      <h2 id="topten-heading" class="label">The top ten, not up for debate</h2>
      <p class="cur-meta">directors verified twice, because once is how mistakes happen</p>
    </div>

    <ol class="top-ten">
      {
        topTen.map((film, index) => (
          <li>
            <span class="num">{String(index + 1).padStart(2, '0')}</span>
            <span class="tt-title">{film.title}</span>
            <span class="leaders" aria-hidden="true" />
            <span class="tt-meta">
              {film.director} · {film.year}
            </span>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .stats {
    margin-top: 2.25rem;
    font-family: var(--mono);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    color: var(--rubric);
  }

  .chart {
    margin-top: 2rem;
  }

  .chart-bars {
    display: flex;
    align-items: stretch;
    gap: clamp(0.35rem, 1vw, 0.7rem);
    height: 9.5rem;
    margin-top: 1.1rem;
  }

  .bar {
    flex: 1;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0.35rem;
    min-width: 0;
  }

  .bar-track {
    display: flex;
    align-items: flex-end;
  }

  .bar-fill {
    width: 100%;
    min-height: 2px;
    background: var(--rubric);
    border-radius: 2px 2px 0 0;
    opacity: 0.8;
    transition: opacity 0.15s ease;
  }

  .bar:hover .bar-fill {
    opacity: 1;
  }

  .bar-label {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    text-align: center;
  }

  .epigraph {
    margin: 2.75rem 0 0;
    padding-top: 1.4rem;
    border-top: 1px solid var(--rule);
    max-width: var(--measure);
  }

  .epigraph p {
    font-family: var(--serif);
    font-size: var(--text-lg);
    line-height: 1.42;
    color: var(--ink-soft);
    margin-bottom: 0.5rem;
  }

  .epigraph .epigraph-source {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    margin-bottom: 0;
  }

  .ledger-section {
    margin-top: 3.5rem;
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.6rem;
    margin-bottom: 0.25rem;
  }

  .section-head .cur-meta {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    margin: 0;
  }

  .film-ledger {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .film-row {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.15rem 1.4rem;
    padding: 0.85rem 0.15rem;
    border-bottom: 1px solid var(--rule-faint);
    transition: background-color 0.15s ease;
  }

  .film-row:hover {
    background-color: rgba(244, 241, 232, 0.03);
  }

  .film-date {
    display: grid;
    gap: 0.12rem;
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    padding-top: 0.42rem;
    white-space: nowrap;
  }

  .film-logged {
    color: var(--rubric);
  }

  .film-info {
    min-width: 0;
  }

  .film-title-line {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.7rem;
  }

  .film-title {
    font-family: var(--serif);
    font-size: var(--text-xl);
    line-height: 1.1;
    color: var(--ink);
    text-decoration: none;
  }

  .film-title:hover {
    color: var(--rubric);
  }

  .film-year {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .film-stars {
    font-size: var(--text-sm);
    color: var(--rubric);
    letter-spacing: 0.08em;
  }

  .film-badge {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rubric);
    border: 1px solid rgba(224, 123, 84, 0.45);
    padding: 0.06rem 0.42rem;
    border-radius: 2px;
  }

  .film-note {
    margin: 0.45rem 0 0;
    max-width: var(--measure);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .film-note-link {
    display: block;
    margin-top: 0.35rem;
    font-family: var(--mono);
    font-size: var(--text-xs);
  }

  .ledger-footnote {
    margin-top: 1.1rem;
    font-family: var(--mono);
    font-size: var(--text-xs);
    line-height: 1.9;
    color: var(--ink-faint);
    max-width: 46rem;
  }

  .top-ten {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-faint);
  }

  .top-ten li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 1rem;
    padding: 0.72rem 0.15rem;
    border-bottom: 1px solid var(--rule-faint);
  }

  .top-ten .num {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--rubric);
    width: 2rem;
    flex: none;
  }

  .top-ten .tt-title {
    font-family: var(--serif);
    font-size: var(--text-xl);
    line-height: 1.05;
  }

  .top-ten .leaders {
    flex: 1 1 2rem;
    border-bottom: 1px dotted var(--rule);
    transform: translateY(-0.32em);
    min-width: 1.5rem;
  }

  .top-ten .tt-meta {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    text-align: right;
  }

  @media (max-width: 40rem) {
    .film-row {
      grid-template-columns: 1fr;
    }

    .film-date {
      padding-top: 0;
      margin-bottom: 0.3rem;
    }

    .top-ten .tt-meta {
      width: 100%;
      text-align: left;
      padding-left: 3rem;
    }

    .bar-label {
      font-size: 0.6rem;
    }
  }
</style>
