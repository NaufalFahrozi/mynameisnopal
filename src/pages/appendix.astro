---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';

interface Entry {
  letter: string;
  text: string;
  href?: string;
  see?: string;
  glitch?: boolean;
}

const entries: Entry[] = [
  { letter: 'A', text: 'About, the author', href: '/about' },
  { letter: 'A', text: 'Antagonist, the audience as', href: '/notes/the-audience-is-the-antagonist/' },
  { letter: 'C', text: 'Cinema', see: 'see Films', href: '/films' },
  { letter: 'C', text: 'Coffee, apparatus & recipe', href: '/commonplace#coffee' },
  { letter: 'C', text: 'Cubing, refusal to invent records', href: '/commonplace#cubing' },
  { letter: 'F', text: 'Films, top ten & ledger', href: '/films' },
  { letter: 'G', text: 'Garmin Exception, the', href: '/commonplace#horology' },
  { letter: 'G', text: 'Games, reading the credits of', href: '/commonplace#games' },
  { letter: 'G', text: 'Grails, order of financial implausibility', href: '/commonplace#horology' },
  { letter: 'H', text: 'Horology', href: '/commonplace#horology' },
  { letter: 'L', text: 'Letterboxd, source of the film ledger', href: 'https://letterboxd.com/NaufalFahrozi' },
  { letter: 'L', text: 'Lucky Strike, one flipped per pack', href: '/commonplace#ritual' },
  { letter: 'N', text: 'Notes, essays & false starts', href: '/notes' },
  { letter: 'O', text: 'One Per Pack, the ritual', href: '/commonplace#ritual' },
  { letter: 'P', text: 'Projects, two for the same wrist', href: '/projects' },
  { letter: 'R', text: 'Reading, currently & favourites', href: '/reading' },
  { letter: 'R', text: 'Rewatches, counted without mercy', href: '/films' },
  { letter: 'S', text: 'SebatSense', href: '/projects' },
  { letter: 'T', text: 'Thesis, title pending', href: '/about' },
  { letter: 'Z', text: 'Zone, pages that wandered into the', href: '/the-zone', glitch: true },
];

const letters = [...new Set(entries.map((entry) => entry.letter))];
---

<Base
  title="Appendix"
  description="An appendix, as in books: cross-references, and one page that does not exist on purpose."
>
  <PageHead kicker="Reel 08 · Appendix" title="Appendix">
    <p>
      Appendix, kayak di buku: rujukan silang dan satu halaman yang emang ga ada. Kalau kamu baca
      ini sampai habis, kamu tipe orang yang juga baca credits film; kita bakal cocok.
    </p>
  </PageHead>

  <div class="appendix-wrap" data-reveal>
    <ol class="index-list">
      {
        entries.map((entry) => (
          <li
            data-letter={entry.letter}
            class:list={[entry.glitch && 'glitch-row']}
            title={entry.glitch ? 'halaman ini emang ga ada. itu intinya.' : undefined}
          >
            <span class="idx-letter">{entry.letter}</span>
            {entry.href ? (
              <a href={entry.href}>
                {entry.text}
                {entry.see && <span class="idx-see"> · {entry.see}</span>}
              </a>
            ) : (
              <span>
                {entry.text}
                {entry.see && <span class="idx-see"> · {entry.see}</span>}
              </span>
            )}
          </li>
        ))
      }
    </ol>

    <nav class="letter-rail" aria-label="Lompat ke huruf">
      {letters.map((letter) => <button type="button" data-letter={letter}>{letter}</button>)}
    </nav>
  </div>
</Base>

<script>
  const setupRail = () => {
    const rail = document.querySelector('.letter-rail');
    if (!rail || (rail as HTMLElement).dataset.wired) return;
    (rail as HTMLElement).dataset.wired = '1';
    rail.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const button = target.closest('button[data-letter]');
      if (!button) return;
      const letter = button.getAttribute('data-letter');
      const row = document.querySelector(`.index-list li[data-letter="${letter}"]`);
      row?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  };
  document.addEventListener('astro:page-load', setupRail);
  setupRail();
</script>

<style>
  .appendix-wrap {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 64rem) {
    .appendix-wrap {
      grid-template-columns: 1fr 2.5rem;
      align-items: start;
    }
  }

  .index-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .index-list li {
    display: flex;
    align-items: baseline;
    gap: 0.35rem 1.2rem;
    padding: 0.38rem 0.1rem;
    border-bottom: 1px solid var(--rule-faint);
    font-size: var(--text-sm);
  }

  .idx-letter {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--rubric);
    width: 1.4rem;
    flex: none;
    text-transform: uppercase;
  }

  .idx-see {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  /* the rail: jump by letter, dictionary style */
  .letter-rail {
    display: none;
  }

  @media (min-width: 64rem) {
    .letter-rail {
      position: sticky;
      top: 6rem;
      display: grid;
      gap: 0.3rem;
    }
  }

  .letter-rail button {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--ink-faint);
    background: none;
    border: 0;
    padding: 0.1rem 0.3rem;
    transition:
      color 0.15s ease,
      transform 0.15s ease;
  }

  .letter-rail button:hover {
    color: var(--rubric);
    transform: translateX(-2px);
  }

  /* the Zone entry glitches, because its page does not exist on purpose */
  .glitch-row a {
    display: inline-block;
  }

  .glitch-row:hover a {
    animation: zone-glitch 0.45s steps(2, end) 1;
  }

  @keyframes zone-glitch {
    0% {
      transform: translateX(0);
      text-shadow: none;
    }
    25% {
      transform: translateX(-2px);
      text-shadow: 2px 0 var(--rubric);
    }
    50% {
      transform: translateX(2px);
      text-shadow: -2px 0 var(--rubric);
    }
    75% {
      transform: translateX(-1px);
      text-shadow: 1px 0 var(--rubric);
    }
    100% {
      transform: translateX(0);
      text-shadow: none;
    }
  }
</style>
