---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';

const projects = [
  {
    kicker: 'Garmin · Monkey C · 2026',
    title: 'SebatSense',
    repo: 'https://github.com/NaufalFahrozi/SebatSense',
    paragraphs: [
      'Tracker rokok dengan filosofi zero-friction: satu ketukan buat nyatet, dan jam nutup sendiri dalam tiga detik. Ga ada form, ga ada konfirmasi berlapis, ga ada apa pun yang berdiri antara kebiasaan dan catatannya.',
      'Yang membuatnya berbeda: Biometric Reality-Slap. Setiap catatan baru membawa jam menelusuri datanya sendiri: lonjakan denyut, level stres puncak, jumlah detak ekstra yang terpaksa dipompa, dan rupiah yang sudah terbakar hari ini. Kadang angka paling jujur adalah angka yang datang dari pergelanganmu sendiri.',
    ],
  },
  {
    kicker: 'Garmin · Monkey C · 2026',
    title: 'GuitarPrompter',
    repo: 'https://github.com/NaufalFahrozi/GuitarPrompter',
    paragraphs: [
      'Smart wrist teleprompter: chords dan lirik jalan di jam tangan, hands-free. Dibikin buat satu masalah nyata: gitaris ga punya tangan ketiga, dan ponsel selalu ada di tempat yang salah.',
      'Kamu mulai lagu, chord-nya muncul di pergelangan; tangan tetap di senar, bukan di layar.',
    ],
  },
];
---

<Base
  title="Projects"
  description="SebatSense and GuitarPrompter · two tools built for the same wrist."
>
  <PageHead kicker="Reel 04 · Projects" title="Projects">
    <p>
      Dua proyek, satu pergelangan. Kodenya terbuka.
    </p>
  </PageHead>

  <div class="project-list">
    {
      projects.map((project) => (
        <article class="project">
          <header class="project-head">
            <p class="label">{project.kicker}</p>
            <h2 class="project-title">{project.title}</h2>
          </header>
          <div class="project-body">
            {project.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {project.title === 'SebatSense' && (
              <div class="demo">
                <button class="demo-btn" id="sebatDemo" type="button">
                  coba: satu ketukan
                </button>
                <p class="demo-line" id="sebatLine">tercatat hari ini: 0</p>
              </div>
            )}
            <p class="repo-link">
              <a href={project.repo}>github.com/NaufalFahrozi/{project.title} →</a>
            </p>
          </div>
        </article>
      ))
    }
  </div>

  <p class="closing-note">
    Dua-duanya Monkey C, dua-duanya open source, dibikin di sela tenggat kuliah. Belum ada yang
    ketiga; "belum" bukan berarti "ga".
  </p>
</Base>

<style>
  .project-list {
    margin-top: 2.75rem;
  }

  .project {
    padding-block: 2rem 1rem;
    border-top: 1px solid var(--rule);
  }

  .project-title {
    font-size: var(--text-2xl);
    margin-top: 0.5rem;
  }

  .project-body {
    margin-top: 1.2rem;
    max-width: var(--measure);
  }

  .project-body p {
    margin-bottom: 1.05em;
  }

  .repo-link {
    font-family: var(--mono);
    font-size: var(--text-sm);
  }

  .demo {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    margin: 0.6rem 0 1rem;
  }

  .demo-btn {
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rubric);
    background: none;
    border: 1px solid rgba(224, 123, 84, 0.5);
    border-radius: 2px;
    padding: 0.45rem 0.9rem;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .demo-btn:hover {
    background: var(--rubric-wash);
  }

  .demo-line {
    margin: 0;
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .closing-note {
    margin-top: 2.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule);
    font-size: var(--text-sm);
    color: var(--ink-soft);
    max-width: var(--measure);
  }
</style>

<script>
  const setupDemo = () => {
    const button = document.getElementById('sebatDemo');
    const line = document.getElementById('sebatLine');
    if (!button || button.dataset.wired) return;
    button.dataset.wired = '1';
    const lines = [
      'jam nutup sendiri dalam 3 detik. sesuai kontrak.',
      'HR spike: +14 bpm. reality slap diterima.',
      'uang terbakar hari ini: bertambah. maaf.',
      'satu ketukan. ga ada form. ga ada drama.',
    ];
    let count = 0;
    button.addEventListener('click', () => {
      count += 1;
      const quip = lines[Math.floor(Math.random() * lines.length)];
      if (line) line.textContent = `tercatat hari ini: ${count} · ${quip}`;
    });
  };
  document.addEventListener('astro:page-load', setupDemo);
  setupDemo();
</script>
