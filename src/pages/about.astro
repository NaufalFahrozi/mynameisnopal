---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';

const now: { key: string; value: string; note?: string }[] = [
  {
    key: 'Thesis',
    value: 'in progress',
    note: 'machine learning, possibly computer vision. Judulnya belum ada; satu-satunya bagian yang belum bisa diaudit.',
  },
  { key: 'Studies', value: 'Informatics, Mulawarman University', note: 'semester tujuh' },
  { key: 'Base', value: 'Samarinda', note: 'a rented room, several ledgers, one kettle' },
  { key: 'Last updated', value: 'October 2026' },
];
---

<Base
  title="About"
  description="Naufal Fahrozi · informatics student, cinephile, reader, keeper of ledgers."
>
  <PageHead kicker="Reel 01 · About" title="About">
    <p>
      The unedited version of this bio was three pages long and named more philosophers than my
      curriculum did. You're welcome for the deletion.
    </p>
  </PageHead>

  <section class="bio prose">
    <p>
      S1 Informatika, Universitas Mulawarman, semester tujuh. Skripsi jalan; arahnya machine
      learning.
    </p>
    <p>
      Literasi artinya bisa jelasin kenapa. Film dibaca, bukan cuma ditonton: gerakan sinema,
      keputusan produksi, siapa memutuskan apa dan kenapa. Buku diadili: argumennya berdiri atau ga.
      Kopi diukur sebelum diminum. Jam dibaca sampai ke mesinnya. Gabisa jelasin kenapa sesuatu
      bagus? Berarti cuma kebetulan menikmatinya.
    </p>
  </section>

  <section class="now" aria-labelledby="now-heading">
    <h2 id="now-heading" class="label">Now</h2>
    <dl class="now-list">
      {
        now.map((item) => (
          <div class="now-row">
            <dt>{item.key}</dt>
            <dd>
              {item.value}
              {item.note && <span class="now-note"> · {item.note}</span>}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</Base>

<style>
  .bio {
    margin-top: 2.75rem;
  }

  .bio p {
    margin-bottom: 1.05em;
  }

  .now {
    margin-top: 3.5rem;
  }

  .now-list {
    margin: 1rem 0 0;
    border-top: 1px solid var(--rule-faint);
  }

  .now-row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 0.2rem 1.3rem;
    padding: 0.7rem 0.15rem;
    border-bottom: 1px solid var(--rule-faint);
  }

  .now-row dt {
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding-top: 0.3rem;
  }

  .now-row dd {
    margin: 0;
    font-size: var(--text-md);
  }

  .now-note {
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  @media (max-width: 34rem) {
    .now-row {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
