---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';

const now: { key: string; value: string; note?: string }[] = [
  {
    key: 'Thesis',
    value: 'in progress',
    note: 'machine learning, possibly computer vision. Judulnya belum ada; urusan antara aku dan waktu.',
  },
  { key: 'Studies', value: 'Informatics, Mulawarman University', note: 'semester tujuh' },
  { key: 'Base', value: 'Samarinda, Borneo', note: 'a rented room, several ledgers, one kettle' },
  { key: 'Last updated', value: 'October 2026' },
];
---

<Base
  title="About"
  description="Naufal Fahrozi · informatics student, cinephile, reader, keeper of ledgers."
>
  <PageHead kicker="I · About" title="About">
    <p>
      The unedited version of this bio was three pages long and named more philosophers than my
      curriculum did. You're welcome for the deletion.
    </p>
  </PageHead>

  <section class="bio prose">
    <p>
      Aku Naufal Fahrozi, mahasiswa S1 Informatika Universitas Mulawarman, semester tujuh, tinggal
      di kos di Samarinda, jauh dari rumah. Pekerjaan resmi: menulis skripsi. Pekerjaan yang
      sebenarnya: menjaga beberapa literasi tetap hidup di jam-jam yang seharusnya dipakai untuk
      tidur.
    </p>
    <p>
      Literasi, dalam pengertianku, bukan sekadar menikmati. Film bukan cuma ditonton, ia dibaca:
      gerakan sinema, sejarah produksi, siapa yang mengambil keputusan dan kenapa. Buku bukan cuma
      dihabiskan, ia diuji: apakah argumennya berdiri, apakah penulisnya jujur. Kopi bukan sekadar
      diminum, ia diseduh dengan parameter, dicatat, lalu diperdebatkan dengan diri sendiri. Jam
      tangan bukan soal harga, tapi soal mesin, sejarah, dan apa yang ingin kamu katakan tanpa
      bicara.
    </p>
    <p>
      Katanya aku orangnya suka satir. Yang benar: aku suka hal-hal yang membuat orang berpikir dua
      kali sebelum bicara, termasuk aku sendiri. Kalau kamu merasa tersinggung sebelum sampai akhir
      kalimat, coba baca ulang; biasanya leluconnya ada di akhir.
    </p>
    <p>
      Situs ini versi digital dari kebiasaan itu: ledger, catatan pinggir, dan beberapa argumen yang
      tidak sempat kubawa ke tongkrongan.
    </p>
  </section>

  <section class="now" aria-labelledby="now-heading">
    <h2 id="now-heading" class="label">Now</h2>
    <dl class="now-list">
      {
        now.map((item) => (
          <div class="now-row">
            <dt>{item.key}</dt>
            <dd>
              {item.value}
              {item.note && <span class="now-note"> · {item.note}</span>}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</Base>

<style>
  .bio {
    margin-top: 2.75rem;
  }

  .bio p {
    margin-bottom: 1.05em;
  }

  .now {
    margin-top: 3.5rem;
  }

  .now-list {
    margin: 1rem 0 0;
    border-top: 1px solid var(--rule-faint);
  }

  .now-row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 0.2rem 1.3rem;
    padding: 0.7rem 0.15rem;
    border-bottom: 1px solid var(--rule-faint);
  }

  .now-row dt {
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding-top: 0.3rem;
  }

  .now-row dd {
    margin: 0;
    font-size: var(--text-md);
  }

  .now-note {
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  @media (max-width: 34rem) {
    .now-row {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
