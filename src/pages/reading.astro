---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { currentlyReading, favourites, readingEpigraph, hardcoverUrl, hardcoverHandle } from '../data/books';
---

<Base
  title="Reading"
  description="Currently reading, five favourites on the shelf. Books kept by hand."
>
  <PageHead kicker="Reel 02 · Reading" title="Reading">
    <p>
      Buku dicatat dengan tangan, bukan algoritma. Halaman ga dihitung; ini bukan lomba.
    </p>
  </PageHead>

  <blockquote class="epigraph">
    <p><em>“{readingEpigraph.text}”</em></p>
    <p class="epigraph-source">— {readingEpigraph.source}</p>
  </blockquote>

  <section class="now-reading" aria-labelledby="now-heading">
    <h2 id="now-heading" class="label">Currently reading</h2>
    <p class="book-title">{currentlyReading.title}</p>
    <p class="book-author">· {currentlyReading.author}</p>
    <p class="shelf-note">
      Jalan lambat dengan sengaja; buku filsafat yang dibaca buru-buru itu definisi membaca yang
      salah. <a href={hardcoverUrl}>Shelf penuhnya di Hardcover</a> ({hardcoverHandle}).
    </p>
  </section>

  <section class="favourites" aria-labelledby="fav-heading" data-reveal>
    <div class="section-head">
      <h2 id="fav-heading" class="label">Five that survived the culling</h2>
      <p class="cur-meta">tarik bukunya buat baca judul lengkap</p>
    </div>

    <div class="shelf">
      {
        favourites.map((book) => (
          <div class="spine" tabindex="0">
            <span class="spine-monogram">{book.title.charAt(0)}</span>
            <span class="spine-vlabel">{book.author}</span>
            <span class="spine-details">
              <span class="spine-title">{book.title}</span>
              <span class="spine-author">{book.author}</span>
            </span>
          </div>
        ))
      }
    </div>

    <p class="shelf-note">
      Stoikisme, Dune, Orwell, Homer, dan Nietzsche di satu daftar; kalau terasa kontradiktif,
      berarti belum dibaca sampai habis.
    </p>
  </section>
</Base>

<style>
  .epigraph {
    margin: 2.5rem 0 0;
    padding-top: 1.4rem;
    border-top: 1px solid var(--rule);
    max-width: var(--measure);
  }

  .epigraph p {
    font-family: var(--serif);
    font-size: var(--text-lg);
    line-height: 1.42;
    color: var(--ink-soft);
    margin-bottom: 0.5rem;
  }

  .epigraph .epigraph-source {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    margin-bottom: 0;
  }

  .now-reading {
    margin-top: 3rem;
  }

  .book-title {
    font-family: var(--serif);
    font-size: var(--text-2xl);
    line-height: 1.08;
    margin: 0.9rem 0 0.2rem;
  }

  .book-author {
    font-family: var(--mono);
    font-size: var(--text-sm);
    color: var(--ink-faint);
    margin: 0;
  }

  .shelf-note {
    margin-top: 1rem;
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .favourites {
    margin-top: 3.25rem;
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.6rem;
    margin-bottom: 0.25rem;
  }

  .section-head .cur-meta {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    margin: 0;
  }

  /* the shelf: spines that pull out and open */
  .shelf {
    display: flex;
    align-items: flex-end;
    gap: 0.65rem;
    padding: 1.75rem 0.3rem 0;
    border-bottom: 6px solid var(--paper-deep);
    overflow-x: auto;
  }

  .spine {
    position: relative;
    flex: none;
    height: 14rem;
    width: 3rem;
    background: var(--paper-deep);
    border: 1px solid var(--rule-faint);
    border-radius: 3px 3px 0 0;
    overflow: hidden;
    transition:
      width 0.28s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background-color 0.2s ease;
  }

  .spine:hover,
  .spine:focus-within {
    width: 15rem;
    transform: translateY(-10px);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.5);
    background: #1d1813;
  }

  .spine-monogram {
    position: absolute;
    top: 0.7rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--serif);
    font-size: 1.4rem;
    line-height: 1;
    color: var(--rubric);
    transition: opacity 0.12s ease;
  }

  .spine-vlabel {
    position: absolute;
    top: 3.1rem;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    writing-mode: vertical-rl;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    white-space: nowrap;
    opacity: 1;
    transition: opacity 0.12s ease;
  }

  .spine:hover .spine-vlabel,
  .spine:focus-within .spine-vlabel,
  .spine:hover .spine-monogram,
  .spine:focus-within .spine-monogram {
    opacity: 0;
  }

  .spine-details {
    position: absolute;
    inset: 0;
    padding: 1.1rem 1.1rem 0.9rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    opacity: 0;
    transition: opacity 0.18s ease 0.08s;
    pointer-events: none;
  }

  .spine:hover .spine-details,
  .spine:focus-within .spine-details {
    opacity: 1;
  }

  .spine-title {
    font-family: var(--serif);
    font-size: 1.22rem;
    line-height: 1.15;
    color: var(--ink);
  }

  .spine-author {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--rubric);
  }

  @media (hover: none) {
    .spine:hover {
      width: 3rem;
      transform: none;
      box-shadow: none;
      background: var(--paper-deep);
    }

    .spine:hover .spine-vlabel,
    .spine:hover .spine-monogram {
      opacity: 1;
    }

    .spine:hover .spine-details {
      opacity: 0;
    }

    .spine:focus-within {
      width: 15rem;
      transform: translateY(-10px);
    }

    .spine:focus-within .spine-vlabel,
    .spine:focus-within .spine-monogram {
      opacity: 0;
    }

    .spine:focus-within .spine-details {
      opacity: 1;
    }
  }
</style>
