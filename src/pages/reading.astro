---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { currentlyReading, favourites, readingEpigraph, hardcoverUrl, hardcoverHandle } from '../data/books';
---

<Base
  title="Reading"
  description="Currently reading, five favourites on the shelf. Books kept by hand."
>
  <PageHead kicker="Reel 03 · Reading" title="Reading">
    <p>
      Buku dicatat dengan tangan, bukan algoritma. Halaman ga dihitung; ini bukan lomba.
    </p>
  </PageHead>

  <blockquote class="epigraph">
    <p><em>“{readingEpigraph.text}”</em></p>
    <p class="epigraph-source">· {readingEpigraph.source}</p>
  </blockquote>

  <section class="now-reading" aria-labelledby="now-heading">
    <h2 id="now-heading" class="label">Currently reading</h2>
    <p class="book-title">{currentlyReading.title}</p>
    <p class="book-author">· {currentlyReading.author}</p>
    <p class="shelf-note">
      Jalan lambat dengan sengaja; buku filsafat yang dibaca buru-buru itu definisi membaca yang
      salah. <a href={hardcoverUrl}>Shelf penuhnya di Hardcover</a> ({hardcoverHandle}).
    </p>
  </section>

  <section class="favourites" aria-labelledby="fav-heading" data-reveal>
    <div class="section-head">
      <h2 id="fav-heading" class="label">Five that survived the culling</h2>
      <p class="cur-meta">hover: keluarin dari rak</p>
    </div>

    <div class="shelf">
      {
        favourites.map((book, index) => (
          <div class="spine" style={`--h: ${12.5 + ((index * 7) % 5)}rem`}>
            <span class="spine-title">{book.title}</span>
            <span class="spine-author">{book.author}</span>
          </div>
        ))
      }
    </div>

    <p class="shelf-note">
      Stoikisme, Dune, Orwell, Homer, dan Nietzsche di satu daftar; kalau terasa kontradiktif,
      berarti belum dibaca sampai habis.
    </p>
  </section>
</Base>

<style>
  .epigraph {
    margin: 2.5rem 0 0;
    padding-top: 1.4rem;
    border-top: 1px solid var(--rule);
    max-width: var(--measure);
  }

  .epigraph p {
    font-family: var(--serif);
    font-size: var(--text-lg);
    line-height: 1.42;
    color: var(--ink-soft);
    margin-bottom: 0.5rem;
  }

  .epigraph .epigraph-source {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    margin-bottom: 0;
  }

  .now-reading {
    margin-top: 3rem;
  }

  .book-title {
    font-family: var(--serif);
    font-size: var(--text-2xl);
    line-height: 1.08;
    margin: 0.9rem 0 0.2rem;
  }

  .book-author {
    font-family: var(--mono);
    font-size: var(--text-sm);
    color: var(--ink-faint);
    margin: 0;
  }

  .shelf-note {
    margin-top: 1rem;
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .favourites {
    margin-top: 3.25rem;
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.6rem;
    margin-bottom: 0.25rem;
  }

  .section-head .cur-meta {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    margin: 0;
  }

  /* the shelf: five spines you can pull out */
  .shelf {
    display: flex;
    align-items: flex-end;
    gap: 0.65rem;
    padding: 1.75rem 0.3rem 0;
    border-bottom: 6px solid var(--paper-deep);
    overflow-x: auto;
  }

  .spine {
    flex: none;
    height: var(--h, 13rem);
    width: 2.7rem;
    background: var(--paper-deep);
    border: 1px solid var(--rule-faint);
    border-radius: 3px 3px 0 0;
    writing-mode: vertical-rl;
    display: flex;
    justify-content: space-between;
    padding: 0.8rem 0.4rem 0.6rem;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background-color 0.2s ease;
  }

  .spine:hover {
    transform: translateY(-12px);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.5);
    background: #1d1813;
  }

  .spine-title {
    font-family: var(--serif);
    font-size: 0.98rem;
    line-height: 1.1;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.15s ease;
  }

  .spine:hover .spine-title {
    color: var(--rubric);
  }

  .spine-author {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
</style>
