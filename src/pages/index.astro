---
import Base from '../layouts/Base.astro';
import { recentFilms } from '../lib/letterboxd';
import { currentlyReading } from '../data/books';
import { filmsEpigraph } from '../data/films';

const { films } = await recentFilms(8);
const lastFilm = films[0];
const strip = films.filter((film) => film.posterSmall).slice(0, 6);

const shortDate = (iso: string | null | undefined) =>
  iso
    ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short' }).format(new Date(iso))
    : null;

const sinceLabel = lastFilm ? shortDate(lastFilm.firstLoggedDate) : null;

const contents: { num: string; href: string; name: string; hint: string }[] = [
  { num: 'I', href: '/about', name: 'About', hint: 'the person, the now, the thesis in progress' },
  { num: 'II', href: '/films', name: 'Films', hint: 'a ledger, synced from Letterboxd' },
  { num: 'III', href: '/reading', name: 'Reading', hint: 'currently, favourites, the shelf' },
  { num: 'IV', href: '/commonplace', name: 'Commonplace', hint: 'coffee, horology, two rituals, one cube' },
  { num: 'V', href: '/projects', name: 'Projects', hint: 'things built, mostly for one wrist' },
  { num: 'VI', href: '/notes', name: 'Notes', hint: 'essays, occasional, footnoted' },
  { num: 'VII', href: '/contact', name: 'Contact', hint: 'post, and elsewhere' },
  { num: 'VIII', href: '/appendix', name: 'Index', hint: 'an index, as in books' },
];
---

<Base>
  <section class="frontispiece">
    <p class="label place">Samarinda · MMXXVI</p>
    <h1 class="display">Naufal<br />Fahrozi</h1>
    <p class="tagline">Cinema, Classics, Cultured, Coffee and Cigarettes</p>
    <div class="lede">
      <p>
        Film, buku, kopi, jam tangan. Empat ledger, satu standar: semuanya harus bisa dijelasin
        kenapa.
      </p>
    </div>
  </section>

  <nav class="contents" aria-label="Contents">
    <p class="label">Contents</p>
    <ol>
      {
        contents.map((item) => (
          <li>
            <a href={item.href}>
              <span class="num">{item.num}</span>
              <span class="name">{item.name}</span>
              <span class="leaders" aria-hidden="true" />
              <span class="hint">{item.hint}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <section class="currently" aria-label="Currently">
    <p class="label">Currently</p>

    {
      lastFilm && (
        <div class="cur-block">
          {lastFilm.posterSmall && (
            <a class="cur-poster" href="/films" aria-hidden="true" tabindex="-1">
              <img
                src={lastFilm.posterSmall}
                alt=""
                loading="lazy"
                decoding="async"
                width="56"
                height="84"
              />
            </a>
          )}
          <div class="cur-lines">
            <p class="cur-line">
              <span class="cur-key">Watching</span>
              <a class="cur-title" href="/films">
                {lastFilm.title} <span class="cur-meta">({lastFilm.year})</span>
              </a>
              <span class="cur-meta">
                <span class="cur-stars">{lastFilm.stars ?? 'unrated'}</span>
                {lastFilm.logCount && lastFilm.logCount > 1 && sinceLabel
                  ? ` · logged ${lastFilm.logCount}× since ${sinceLabel}`
                  : sinceLabel
                    ? ` · last log ${sinceLabel}`
                    : ''}
              </span>
            </p>
            <p class="cur-line">
              <span class="cur-key">Reading</span>
              <a class="cur-title" href="/reading">{currentlyReading.title}</a>
              <span class="cur-meta">· {currentlyReading.author}</span>
            </p>
          </div>
        </div>
      )
    }
  </section>

  {
    strip.length >= 3 && (
      <section class="strip" aria-label="Recently watched">
        <div class="strip-row">
          {strip.map((film) => (
            <a class="strip-item" href="/films" title={film.title}>
              <img
                src={film.posterSmall as string}
                alt={film.title}
                loading="lazy"
                decoding="async"
                width="54"
                height="81"
              />
            </a>
          ))}
        </div>
        <p class="strip-caption">
          <a href="/films">ledger film →</a>
        </p>
      </section>
    )
  }

  <aside class="epigraph-home" aria-label="Epigraph">
    <hr />
    <blockquote class="measure">
      <p><em>“{filmsEpigraph.text}”</em></p>
      <p class="cur-meta">· {filmsEpigraph.source}</p>
    </blockquote>
  </aside>
</Base>

<style>
  .cur-block {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
  }

  .cur-poster {
    flex: none;
    display: block;
    box-shadow: 0 2px 10px rgba(26, 23, 20, 0.18);
    border-radius: 2px;
    overflow: hidden;
  }

  .cur-poster img {
    display: block;
  }

  .cur-lines {
    display: grid;
    gap: 0.65rem;
  }

  .strip {
    margin-top: 2.25rem;
  }

  .strip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .strip-item {
    display: block;
    border-radius: 2px;
    overflow: hidden;
    box-shadow: 0 2px 10px rgba(26, 23, 20, 0.16);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  .strip-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 22px rgba(26, 23, 20, 0.24);
  }

  .strip-item img {
    display: block;
    width: clamp(2.9rem, 12vw, 3.5rem);
    height: auto;
  }

  .strip-caption {
    margin: 0.7rem 0 0;
    font-family: var(--mono);
    font-size: var(--text-xs);
  }

  .epigraph-home {
    margin-top: 3.25rem;
  }

  .epigraph-home blockquote {
    margin: 0;
    max-width: var(--measure);
  }

  .epigraph-home blockquote p {
    font-family: var(--serif);
    font-size: var(--text-lg);
    line-height: 1.4;
    color: var(--ink-soft);
    margin-bottom: 0.6rem;
  }

  .cur-stars {
    color: var(--rubric);
    letter-spacing: 0.08em;
  }
</style>
