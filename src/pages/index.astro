---
import Base from '../layouts/Base.astro';
import Countdown from '../components/Countdown.astro';
import { recentFilms } from '../lib/letterboxd';
import { currentlyReading } from '../data/books';
import { filmsEpigraph } from '../data/films';

const { films } = await recentFilms(8);
const lastFilm = films[0];

const shortDate = (iso: string | null | undefined) =>
  iso
    ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short' }).format(new Date(iso))
    : null;

const sinceLabel = lastFilm ? shortDate(lastFilm.firstLoggedDate) : null;

const marqueeItems = ['Cinema', '·', 'Classics', '·', 'Cultured', '·', 'Coffee and Cigarettes', '·'];

const program: { num: string; href: string; name: string; hint: string }[] = [
  { num: '01', href: '/about', name: 'About', hint: 'the person, the now, the thesis in progress' },
  { num: '02', href: '/films', name: 'Films', hint: 'a ledger, synced from Letterboxd' },
  { num: '03', href: '/reading', name: 'Reading', hint: 'currently, favourites, the shelf' },
  { num: '04', href: '/commonplace', name: 'Commonplace', hint: 'coffee, horology, two rituals, one cube' },
  { num: '05', href: '/projects', name: 'Projects', hint: 'things built, mostly for one wrist' },
  { num: '06', href: '/notes', name: 'Notes', hint: 'essays, occasional, footnoted' },
  { num: '07', href: '/contact', name: 'Contact', hint: 'post, and elsewhere' },
  { num: '08', href: '/appendix', name: 'Index', hint: 'an index, as in books' },
];
---

<Base>
  <Countdown />

  <section class="hero" id="hero">
    <p class="label">mynameisnopal presents</p>
    <h1 class="display">Naufal<br />Fahrozi</h1>
    <p class="tagline">Cinema, Classics, Cultured, Coffee and Cigarettes</p>
    <p class="hero-sub">
      Film, buku, kopi, jam tangan. Empat ledger, satu standar: semuanya harus bisa dijelasin kenapa.
    </p>
    <p class="scroll-hint">scroll <span>↓</span></p>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {
        [...marqueeItems, ...marqueeItems].map((item, index) => (
          <span class:list={['marquee-item', index % 2 === 1 && 'alt']}>{item}</span>
        ))
      }
    </div>
  </div>

  <nav class="contents" aria-label="Program" data-reveal>
    <p class="label">Program</p>
    <ol>
      {
        program.map((item) => (
          <li>
            <a href={item.href}>
              <span class="num">{item.num}</span>
              <span class="name">{item.name}</span>
              <span class="leaders" aria-hidden="true" />
              <span class="hint">{item.hint}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <section class="currently" aria-label="Now showing" data-reveal>
    <p class="label">Now showing</p>

    {
      lastFilm && (
        <p class="cur-line">
          <span class="cur-key">Watching</span>
          <a class="cur-title" href="/films">
            {lastFilm.title} <span class="cur-meta">({lastFilm.year})</span>
          </a>
          <span class="cur-meta">
            <span class="cur-stars">{lastFilm.stars ?? 'unrated'}</span>
            {lastFilm.logCount && lastFilm.logCount > 1 && sinceLabel
              ? ` · logged ${lastFilm.logCount}× since ${sinceLabel}`
              : sinceLabel
                ? ` · last log ${sinceLabel}`
                : ''}
          </span>
        </p>
      )
    }

    <p class="cur-line">
      <span class="cur-key">Reading</span>
      <a class="cur-title" href="/reading">{currentlyReading.title}</a>
      <span class="cur-meta">· {currentlyReading.author}</span>
    </p>
  </section>

  <aside class="epigraph-home" data-reveal>
    <hr />
    <blockquote class="measure">
      <p><em>“{filmsEpigraph.text}”</em></p>
      <p class="cur-meta">· {filmsEpigraph.source}</p>
    </blockquote>
  </aside>
</Base>

<script>
  const hero = document.getElementById('hero');
  if (hero && window.matchMedia('(hover: hover)').matches) {
    hero.addEventListener('pointermove', (event) => {
      const rect = hero.getBoundingClientRect();
      hero.style.setProperty('--mx', `${event.clientX - rect.left}px`);
      hero.style.setProperty('--my', `${event.clientY - rect.top}px`);
    });
  }
</script>

<style>
  .epigraph-home {
    margin-top: 3.5rem;
  }

  .epigraph-home blockquote {
    margin: 0;
    max-width: var(--measure);
  }

  .epigraph-home blockquote p {
    font-family: var(--serif);
    font-size: var(--text-lg);
    line-height: 1.4;
    color: var(--ink-soft);
    margin-bottom: 0.6rem;
  }
</style>
