---
import Base from '../layouts/Base.astro';
import Countdown from '../components/Countdown.astro';
import { recentFilms } from '../lib/letterboxd';
import { currentlyReading } from '../data/books';
import { filmsEpigraph } from '../data/films';

const { films } = await recentFilms(8);
const lastFilm = films[0];

const shortDate = (iso: string | null | undefined) =>
  iso
    ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short' }).format(new Date(iso))
    : null;

const sinceLabel = lastFilm ? shortDate(lastFilm.firstLoggedDate) : null;

const ledgers: { num: string; href: string; name: string; hint: string }[] = [
  { num: '02', href: '/films', name: 'Films', hint: 'ledger, synced from Letterboxd' },
  { num: '03', href: '/reading', name: 'Reading', hint: 'currently, favourites, the shelf' },
  { num: '04', href: '/commonplace', name: 'Commonplace', hint: 'coffee, horology, two rituals, one cube' },
  { num: '05', href: '/projects', name: 'Projects', hint: 'things built, mostly for one wrist' },
];
---

<Base>
  <Countdown />

  <section class="hero" id="hero">
    <p class="label">mynameisnopal presents</p>
    <h1 class="display" id="heroTitle">Naufal<br />Fahrozi</h1>
    <p class="tagline">Cinema, Classics, Cultured, Coffee and Cigarettes</p>
    <p class="hero-sub">
      Film, buku, kopi, jam tangan. Empat ledger, satu standar: semuanya harus bisa dijelasin kenapa.
    </p>
    <p class="scroll-hint">scroll <span>↓</span></p>
  </section>

  <section class="switchboard" data-reveal aria-label="The ledgers">
    <p class="label">The ledgers</p>
    {
      ledgers.map((ledger) => (
        <a class="switch-row" href={ledger.href}>
          <span class="sw-num">{ledger.num}</span>
          <span class="sw-name">{ledger.name}</span>
          <span class="sw-hint">{ledger.hint}</span>
        </a>
      ))
    }
  </section>

  <nav class="micro-nav" aria-label="Also" data-reveal>
    <a href="/about">01 About</a>
    <a href="/notes">06 Notes</a>
    <a href="/contact">07 Contact</a>
    <a href="/appendix">08 Index</a>
  </nav>

  <section class="currently" aria-label="Now showing" data-reveal>
    <p class="label">Now showing</p>

    {
      lastFilm && (
        <p class="cur-line">
          <span class="cur-key">Watching</span>
          <a class="cur-title" href="/films">
            {lastFilm.title} <span class="cur-meta">({lastFilm.year})</span>
          </a>
          <span class="cur-meta">
            <span class="cur-stars">{lastFilm.stars ?? 'unrated'}</span>
            {lastFilm.logCount && lastFilm.logCount > 1 && sinceLabel
              ? ` · logged ${lastFilm.logCount}× since ${sinceLabel}`
              : sinceLabel
                ? ` · last log ${sinceLabel}`
                : ''}
          </span>
        </p>
      )
    }

    <p class="cur-line">
      <span class="cur-key">Reading</span>
      <a class="cur-title" href="/reading">{currentlyReading.title}</a>
      <span class="cur-meta">· {currentlyReading.author}</span>
    </p>
  </section>

  <aside class="epigraph-home" data-reveal>
    <hr />
    <blockquote class="measure">
      <p><em>“{filmsEpigraph.text}”</em></p>
      <p class="cur-meta">· {filmsEpigraph.source}</p>
    </blockquote>
  </aside>
</Base>

<script>
  const setupHero = () => {
    const hero = document.getElementById('hero');
    const title = document.getElementById('heroTitle');
    if (!hero || !title) return;

    const canHover = window.matchMedia('(hover: hover)').matches;

    if (canHover) {
      hero.addEventListener('pointermove', (event) => {
        const rect = hero.getBoundingClientRect();
        hero.style.setProperty('--mx', `${event.clientX - rect.left}px`);
        hero.style.setProperty('--my', `${event.clientY - rect.top}px`);
      });
    }

    if (title.dataset.magnetic) return;
    title.dataset.magnetic = '1';

    const letters: HTMLElement[] = [];
    const parts = title.innerHTML.split('<br>');
    title.innerHTML = '';
    parts.forEach((part, partIndex) => {
      if (partIndex > 0) title.appendChild(document.createElement('br'));
      for (const ch of part) {
        const span = document.createElement('span');
        span.className = 'mag';
        span.textContent = ch === ' ' ? '\u00a0' : ch;
        title.appendChild(span);
        if (ch.trim()) letters.push(span);
      }
    });

    if (!canHover) return;

    hero.addEventListener('pointermove', (event) => {
      for (const el of letters) {
        const rect = el.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        const dx = event.clientX - cx;
        const dy = event.clientY - cy;
        const dist = Math.hypot(dx, dy);
        const power = Math.max(0, 1 - dist / 260);
        el.style.transform = `translate(${dx * 0.16 * power}px, ${dy * 0.16 * power}px)`;
      }
    });

    hero.addEventListener('pointerleave', () => {
      for (const el of letters) el.style.transform = '';
    });
  };

  document.addEventListener('astro:page-load', setupHero);
  setupHero();
</script>

<style>
  .epigraph-home {
    margin-top: 3.5rem;
  }

  .epigraph-home blockquote {
    margin: 0;
    max-width: var(--measure);
  }

  .epigraph-home blockquote p {
    font-family: var(--serif);
    font-size: var(--text-lg);
    line-height: 1.4;
    color: var(--ink-soft);
    margin-bottom: 0.6rem;
  }
</style>
