---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);

const fmt = (date: Date) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(date);
---

<Base title={note.data.title} description={note.data.description}>
  <article class="essay">
    <header class="essay-head">
      <p class="label">VI · Notes</p>
      <h1 class="essay-title">{note.data.title}</h1>
      <p class="essay-meta">
        {fmt(note.data.date)}{note.data.source && <span> · {note.data.source}</span>}
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="essay-foot">
      <hr />
      <p><a href="/notes">← Semua Notes</a></p>
    </footer>
  </article>
</Base>

<style>
  .essay {
    padding-block: clamp(2.5rem, 7vh, 4.5rem) 0;
  }

  .essay-title {
    font-size: var(--text-3xl);
    margin-top: 0.55rem;
    max-width: 24ch;
  }

  .essay-meta {
    margin-top: 1.1rem;
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .prose {
    margin-top: 2.4rem;
    max-width: var(--measure);
  }

  .essay-foot {
    margin-top: 3.5rem;
    max-width: var(--measure);
    font-family: var(--mono);
    font-size: var(--text-xs);
  }

  .essay-foot hr {
    margin-bottom: 1.2rem;
  }
</style>
