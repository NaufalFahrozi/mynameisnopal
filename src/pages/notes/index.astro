---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (date: Date) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(date);
---

<Base title="Notes" description="Essays, occasional, footnoted.">
  <PageHead kicker="Reel 06 · Notes" title="Notes">
    <p>
      Essay, sesekali, tanpa jadwal. Semuanya ditulis serius, termasuk yang bercanda. Yang terbit
      di tempat lain nyebutin sumbernya.
    </p>
  </PageHead>

  {notes.length === 0 && (
    <p class="empty-note">
      Belum ada tulisan. Diogenes nyalain lentera di siang bolong dan ga nemu apa-apa juga;
      bedanya, dia ga ninggalin halaman kosong yang rapi.
    </p>
  )}

  <ol class="notes-list">
    {
      notes.map((note) => (
        <li>
          <a href={`/notes/${note.id}/`}>
            <span class="note-date">{fmt(note.data.date)}</span>
            <span class="note-title">{note.data.title}</span>
            <span class="note-desc">{note.data.description}</span>
          </a>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .empty-note {
    margin-top: 2.5rem;
    max-width: var(--measure);
    color: var(--ink-soft);
    font-style: italic;
  }

  .notes-list {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .notes-list li {
    border-bottom: 1px solid var(--rule-faint);
  }

  .notes-list a {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 0.2rem 1.3rem;
    padding: 1rem 0.15rem;
    text-decoration: none;
    color: var(--ink);
  }

  .note-date {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    padding-top: 0.5rem;
  }

  .note-title {
    font-family: var(--serif);
    font-size: var(--text-xl);
    line-height: 1.1;
  }

  .note-desc {
    grid-column: 2;
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .notes-list a:hover .note-title {
    color: var(--rubric);
  }

  @media (max-width: 38rem) {
    .notes-list a {
      grid-template-columns: 1fr;
    }

    .note-desc {
      grid-column: 1;
    }
  }
</style>
